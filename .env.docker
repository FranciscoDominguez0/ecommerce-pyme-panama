###############################################################################
# .env.docker — Variables de entorno para el stack Docker
#
# Uso:
#   cp .env.docker .env
#   # Edita las contraseñas
#   docker compose up --build -d
###############################################################################

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME="PayMe Panamá"
APP_ENV=production
# Genera con: php artisan key:generate --show
APP_KEY=base64:REEMPLAZA_CON_TU_APP_KEY
APP_DEBUG=false
APP_URL=https://tudominio.com
# Puerto local al que Nginx del VPS hace proxy_pass
APP_PORT=8080

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# Accesible solo en localhost del VPS (127.0.0.1:5432)
# Desde el VPS: psql -h 127.0.0.1 -p 5432 -U app_user ecommerce_pyme_panama
DB_DATABASE=ecommerce_pyme_panama
DB_USERNAME=app_user
DB_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURA

# ── Administrador inicial ─────────────────────────────────────────────────────
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Principal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# ── Control del entrypoint ────────────────────────────────────────────────────
RUN_MIGRATIONS=true

# ── Correo ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=TU_APP_PASSWORD_GMAIL
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="PayMe Panamá"
