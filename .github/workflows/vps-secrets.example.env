# =====================================================================
# SECRETS PARA EL DEPLOY (CI/CD) — eCommerce PyME Panamá
# =====================================================================
# ESTE ARCHIVO NO SE SUBE A GIT (está en .gitignore).
#
# Cómo usarlo:
#   1. Rellena los 3 valores abajo con tus datos reales del VPS.
#   2. Cópialos en GitHub: repo > Settings > Secrets and variables >
#      Actions > New repository secret.
#      Los nombres del secret DEBEN ser exactamente:
#        VPS_HOST, VPS_USER, VPS_SSH_KEY
#   3. Después del primer deploy, puedes borrar este archivo local
#      o mantenerlo como respaldo. GitHub NUNCA lee este archivo.
# =====================================================================

# IP pública o dominio del VPS (ej: 185.120.80.10 o vmi3432269.tu.proveedor.com)
VPS_HOST=

# Usuario SSH de despliegue (root en tu caso)
VPS_USER=root

# Puerto SSH del VPS (el workflow ya usa 2222 por defecto)
VPS_PORT=2222

# Clave PRIVADA SSH del VPS, en formato PEM (una sola línea con \n reales).
# Es la que usa root al conectarse (id_rsa / id_ed25519).
# Copia TODO el bloque desde "-----BEGIN OPENSSH PRIVATE KEY-----"
# hasta "-----END OPENSSH PRIVATE KEY-----".
VPS_SSH_KEY=
